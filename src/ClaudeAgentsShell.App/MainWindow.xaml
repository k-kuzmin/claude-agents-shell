<Window x:Class="ClaudeAgentsShell.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ClaudeAgentsShell.App.Views"
        xmlns:vm="clr-namespace:ClaudeAgentsShell.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Claude Agents Shell"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStyle="None"
        ResizeMode="CanResize">

    <!--
        Своё обрамление вместо системного (макет, секция «Главное окно»).
        AllowsTransparency не включается никогда: окно с попиксельной прозрачностью
        не может держать дочерний HWND, а под областью терминала живёт WebView2.
        CaptionHeight отдаёт полосу заголовка системе — оттуда бесплатно приходят
        перетаскивание, двойной клик «развернуть/восстановить» и прилипание к краям.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static sw:SystemCommands.MinimizeWindowCommand}" Executed="OnMinimizeWindow" />
        <CommandBinding Command="{x:Static sw:SystemCommands.MaximizeWindowCommand}" Executed="OnMaximizeWindow" />
        <CommandBinding Command="{x:Static sw:SystemCommands.RestoreWindowCommand}" Executed="OnRestoreWindow" />
        <CommandBinding Command="{x:Static sw:SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- «Развернуть» и «Восстановить» — две кнопки, каждая видна в своём состоянии
                 окна. Подмена глифа и команды внутри одной кнопки потребовала бы либо
                 конвертера, либо кода в код-бихайде ради того же результата. -->
            <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid TextElement.FontFamily="{StaticResource UiFontFamily}"
          TextElement.Foreground="{StaticResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- полоса заголовка приложения (раздел 6.1 ТЗ, макет — секция «Главное окно») -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="Claude Agents Shell"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">

                    <!-- Окно настроек приезжает в M5: кнопка на месте, но отключена. -->
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Настройки (этап M5)"
                            AutomationProperties.Name="Настройки">
                        <Canvas Width="15" Height="15">
                            <Ellipse Canvas.Left="2.2" Canvas.Top="2.2" Width="10.6" Height="10.6"
                                     Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="5.6" Canvas.Top="5.6" Width="3.8" Height="3.8"
                                     Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" />
                            <Path Style="{StaticResource IconPathStyle}"
                                  StrokeThickness="1.5"
                                  Stroke="{StaticResource MutedTextBrush}"
                                  Data="M7.5,0.6 L7.5,2.4 M7.5,12.6 L7.5,14.4 M0.6,7.5 L2.4,7.5 M12.6,7.5 L14.4,7.5" />
                        </Canvas>
                    </Button>

                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Command="{x:Static sw:SystemCommands.MinimizeWindowCommand}"
                            ToolTip="Свернуть"
                            AutomationProperties.Name="Свернуть">
                        <Path Style="{StaticResource IconPathStyle}"
                              StrokeThickness="1.3"
                              Stroke="{StaticResource MutedTextBrush}"
                              Data="M2,6 L13,6" />
                    </Button>

                    <Button Style="{StaticResource MaximizeButtonStyle}"
                            Command="{x:Static sw:SystemCommands.MaximizeWindowCommand}"
                            ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть">
                        <Path Style="{StaticResource IconPathStyle}"
                              StrokeThickness="1.3"
                              Stroke="{StaticResource MutedTextBrush}"
                              Data="M2,2 L11,2 L11,11 L2,11 Z" />
                    </Button>

                    <Button Style="{StaticResource RestoreButtonStyle}"
                            Command="{x:Static sw:SystemCommands.RestoreWindowCommand}"
                            ToolTip="Восстановить"
                            AutomationProperties.Name="Восстановить">
                        <Canvas Width="13" Height="13">
                            <Path Style="{StaticResource IconPathStyle}"
                                  StrokeThickness="1.3"
                                  Stroke="{StaticResource MutedTextBrush}"
                                  Data="M4,2 L11,2 L11,9" />
                            <Path Style="{StaticResource IconPathStyle}"
                                  StrokeThickness="1.3"
                                  Stroke="{StaticResource MutedTextBrush}"
                                  Data="M1.5,4.5 L8.5,4.5 L8.5,11.5 L1.5,11.5 Z" />
                        </Canvas>
                    </Button>

                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Style="{StaticResource IconPathStyle}"
                              StrokeThickness="1.3"
                              Stroke="{StaticResource MutedTextBrush}"
                              Data="M2.5,2.5 L11.5,11.5 M11.5,2.5 L2.5,11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- панель проектов -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,1,0">
                <views:ProjectsPanel />
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource WorkAreaBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,0,0,1">
                    <views:TabStrip />
                </Border>

                <Grid Grid.Row="1">
                    <!--
                        Ровно один WebView2 на всё окно; он кладётся сюда из моста.
                        Отступ справа и снизу равен ResizeBorderThickness: без него дочерний
                        HWND браузера накрывает края окна, WM_NCHITTEST до окна не доходит,
                        и окно перестаёт тянуться за правый и нижний край.
                        Скрытие — Hidden, а не Collapsed: место в разметке сохраняется,
                        и возврат к вкладке не даёт странице лишнего пересчёта cols/rows.
                    -->
                    <Grid x:Name="TerminalHost" Margin="0,0,6,6">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTerminalVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>

                    <!-- У выбранного проекта нет ни одной вкладки: показывать терминал
                         чужого проекта было бы обманом, поэтому здесь подсказка. -->
                    <TextBlock Text="{Binding TerminalPlaceholderText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="12.5"
                               LineHeight="20"
                               Foreground="{StaticResource DisabledTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTerminalVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
