<Window x:Class="ClaudeAgentsShell.App.Views.WebView2MissingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeAgentsShell.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WebView2MissingViewModel}"
        Title="Claude Agents Shell"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!--
        Окно поднимается, когда главное окно уже на экране, но работать не может.
        Своя тема и своё обрамление здесь не украшательство: системный MessageBox выглядит
        чужеродно и не умеет ни ссылки, ни раскрывающегося блока подробностей.
        Ресурсы темы подключаются прямо здесь — App.xaml их не держит, и без этого явного
        слияния окно отрисовалось бы стандартным светлым диалогом.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Кнопка основного действия: та же плоская кнопка, что и везде, но акцентом.
                 Отступы задаются содержимым: шаблон FlatButtonStyle не пробрасывает Padding. -->
            <Style x:Key="AccentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Height" Value="32" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
                <Setter Property="Height" Value="32" />
            </Style>

            <!-- Текст, который нужно выделять и копировать в отчёт об ошибке: поле ввода
                 только для чтения. Обычный TextBlock выделять мышью не даёт, а порт работы
                 с буфером обмена ради одной кнопки заводить не за что. -->
            <Style x:Key="CopyableTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="1"
            Background="{StaticResource WindowBackgroundBrush}"
            TextElement.FontFamily="{StaticResource UiFontFamily}"
            TextElement.Foreground="{StaticResource PrimaryTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- полоса заголовка: та же, что у главного окна, чтобы окно читалось как его часть -->
            <Border x:Name="CaptionBar"
                    Grid.Row="0"
                    Background="{StaticResource ChromeBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnCaptionBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="Claude Agents Shell"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CaptionButtonStyle}"
                            Margin="0,0,4,0"
                            Click="OnCloseClick"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Style="{StaticResource IconPathStyle}"
                              StrokeThickness="1.3"
                              Stroke="{StaticResource MutedTextBrush}"
                              Data="M2.5,2.5 L11.5,11.5 M11.5,2.5 L2.5,11.5" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,20">
                <TextBlock Text="Не хватает компонента"
                           Style="{StaticResource SectionCaptionStyle}" />

                <TextBlock Text="Не найден движок, на котором рисуются терминалы"
                           Margin="0,8,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <!-- Человеческое объяснение приходит из самого сбоя: одна формулировка
                     на приложение, а не две расходящиеся — в коде и в разметке. -->
                <TextBlock Text="{Binding Message}"
                           Margin="0,10,0,0"
                           FontSize="12.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock Margin="0,10,0,0"
                           FontSize="12.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Установите бесплатный Microsoft Edge WebView2 Runtime (редакция Evergreen) и запустите Claude Agents Shell снова. Установка занимает пару минут и не требует перезагрузки. Никаких других изменений в системе приложению не нужно." />

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource AccentActionButtonStyle}"
                            Command="{Binding OpenInstallerCommand}"
                            AutomationProperties.Name="Открыть страницу загрузки">
                        <TextBlock Text="Открыть страницу загрузки" Margin="16,0" FontSize="12.5" />
                    </Button>

                    <Button Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding ToggleDetailsCommand}"
                            AutomationProperties.Name="{Binding DetailsToggleText}">
                        <TextBlock Text="{Binding DetailsToggleText}" Margin="14,0" FontSize="12.5" />
                    </Button>

                    <!-- Закрытие идёт через Close(), а не через IsCancel: DialogResult
                         выставляется только у окна, показанного как модальное, и пара
                         «обработчик плюс IsCancel» дала бы присваивание уже закрытому окну. -->
                    <Button Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="8,0,0,0"
                            Click="OnCloseClick"
                            AutomationProperties.Name="Закрыть приложение">
                        <TextBlock Text="Закрыть" Margin="14,0" FontSize="12.5" />
                    </Button>
                </StackPanel>

                <!-- Браузер не открылся: ссылку надо показать текстом, иначе разговор
                     заканчивается тупиком. -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsInstallerLinkFailed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Не удалось открыть браузер. Адрес страницы можно скопировать отсюда:"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource FaintTextBrush}" />
                    <TextBox Style="{StaticResource CopyableTextStyle}"
                             Margin="0,4,0,0"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="11.5"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             Text="{Binding InstallerUrl, Mode=OneWay}" />
                </StackPanel>

                <!-- Подробности для отчёта об ошибке: цепочка причин без стек-трейса. -->
                <Border Margin="0,16,0,0"
                        Padding="12,10"
                        CornerRadius="6"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        Background="{StaticResource ChromeBackgroundBrush}"
                        Visibility="{Binding AreDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Style="{StaticResource CopyableTextStyle}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             FontSize="11"
                             MaxHeight="160"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Технические подробности"
                             Text="{Binding Details, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
