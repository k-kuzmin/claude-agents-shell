<Window x:Class="ClaudeAgentsShell.App.Views.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="clr-namespace:ClaudeAgentsShell.App.History"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=history:SessionHistoryViewModel}"
        Title="{Binding WindowTitle}"
        Width="720"
        Height="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromeBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStyle="None"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
        Разметка — по docs/mockup.html, секция «Продолжить — история сессий».
        Обрамление своё, как у диалога настроек проекта: полоса заголовка с именем проекта
        (фильтра по проектам нет — решение пользователя по M3) и крестиком, под ней поиск.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Текст на акцентной плашке «Enter». -->
            <SolidColorBrush x:Key="OnAccentTextBrush" Color="#1A0E08" />

            <!-- Поле поиска без собственной рамки: рамку рисует обёртка с лупой. -->
            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка списка. Фокус не берёт: выделением управляет ViewModel, клавиши — окно. -->
            <Style x:Key="HistoryRowStyle" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnRowMouseDown" />
                <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="9"
                                    Padding="12,10">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource RowHoverBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="HistoryRowTemplate" DataType="{x:Type history:SessionHistoryRowViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                        </DataTrigger>
                                        <!-- Заголовка нет — видно, что это имя файла, а не сообщение. -->
                                        <DataTrigger Binding="{Binding IsTitleMissing}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Details}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource FaintTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="открыта"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource CalmBrush}"
                                   Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <Border Height="28"
                                Margin="10,0,0,0"
                                Padding="12,0"
                                CornerRadius="7"
                                Background="{StaticResource AccentBrush}"
                                Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Enter"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource OnAccentTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid TextElement.FontFamily="{StaticResource UiFontFamily}"
              TextElement.Foreground="{StaticResource PrimaryTextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- полоса заголовка: чья это история, и закрытие -->
            <Border Grid.Row="0"
                    Height="40"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="История сессий"
                                   FontSize="12.5"
                                   Foreground="{StaticResource FaintTextBrush}" />
                        <TextBlock Text="{Binding ProjectName}"
                                   Margin="8,0,0,0"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="560" />
                    </StackPanel>

                    <!-- Не IsCancel: Esc обрабатывает окно, второй обладатель клавиши не нужен. -->
                    <Button HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            Style="{StaticResource CaptionButtonStyle}"
                            Focusable="False"
                            Click="OnCloseClick"
                            ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть">
                        <Path Style="{StaticResource IconPathStyle}"
                              StrokeThickness="1.3"
                              Stroke="{StaticResource MutedTextBrush}"
                              Data="M2.5,2.5 L11.5,11.5 M11.5,2.5 L2.5,11.5" />
                    </Button>
                </Grid>
            </Border>

            <!-- поиск -->
            <Border Grid.Row="1"
                    Padding="16,14"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,0,0,1">
                <Border Height="36"
                        Padding="12,0"
                        Background="{StaticResource WindowBackgroundBrush}"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="14"
                              Height="14"
                              Margin="0,0,9,0"
                              Stretch="Uniform"
                              Style="{StaticResource IconPathStyle}"
                              StrokeThickness="2"
                              Stroke="{StaticResource FaintTextBrush}"
                              Data="M4,11 A7,7 0 1 0 18,11 A7,7 0 1 0 4,11 Z M20,20 L16.5,16.5" />

                        <TextBlock Grid.Column="1"
                                   Text="Поиск по первому сообщению…"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Поиск по сессиям" />
                    </Grid>
                </Border>
            </Border>

            <!-- список: без внешней прокрутки, иначе виртуализация отключится -->
            <Grid Grid.Row="2">
                <!-- SelectedItem только в одну сторону: при замене списка WPF обнулил бы
                     выделение и записал null во ViewModel раньше, чем она перенесёт его
                     по идентификатору сессии. Щелчок выделяет строку через OnRowMouseDown. -->
                <ListBox x:Name="SessionList"
                         Padding="8"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                         ItemContainerStyle="{StaticResource HistoryRowStyle}"
                         ItemTemplate="{StaticResource HistoryRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Сессии" />

                <TextBlock Text="{Binding EmptyText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{StaticResource FaintTextBrush}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmptyText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- подвал: подсказка по клавишам и состояние загрузки -->
            <Border Grid.Row="3"
                    Padding="16,11"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,1,0,0">
                <DockPanel TextElement.FontSize="11"
                           TextElement.FontFamily="{StaticResource MonoFontFamily}"
                           TextElement.Foreground="{StaticResource DisabledTextBrush}">
                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" Text="{Binding FooterStatus}" />
                    <TextBlock Text="↑↓ выбрать · Enter — открыть во вкладке · Esc — закрыть"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
