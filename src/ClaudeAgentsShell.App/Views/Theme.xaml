<!--
    Цвета и размеры взяты из docs/mockup.html, секция «Главное окно».
    Держатся в одном месте, чтобы разметка панелей не повторяла коды цветов.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- фон -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121211" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#191816" />
    <SolidColorBrush x:Key="WorkAreaBackgroundBrush" Color="#0E0E0D" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#262320" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#35302B" />

    <!-- линии -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2B2825" />
    <SolidColorBrush x:Key="OutlineBrush" Color="#332F2B" />

    <!-- текст -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E9E6E0" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9C4BB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9C968C" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#8A857C" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6E6960" />

    <!-- акцент и состояния вкладок -->
    <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
    <SolidColorBrush x:Key="CalmBrush" Color="#6FA8A0" />
    <SolidColorBrush x:Key="UnknownStateBrush" Color="#4A4640" />
    <!-- Работа в фоне: сессия занята собственными сабагентами, от человека ничего не нужно.
         Свой холодный тон, чтобы не путаться ни с «работает» (CalmBrush), ни с «ждёт ввода». -->
    <SolidColorBrush x:Key="BackgroundWorkBrush" Color="#6E86B0" />
    <!-- Пометка о ненулевом коде выхода: процесс сессии упал (раздел 8 ТЗ). Намеренно не
         AccentBrush — тем же оранжевым горит точка «ждёт ввода», и на одной вкладке два
         оранжевых знака читались бы как один. Приглушённый красный ни с чем не спорит.
         Нулевой код — штатный выход, ему хватает FaintTextBrush, своей кисти он не требует. -->
    <SolidColorBrush x:Key="ExitFailureBrush" Color="#C2564A" />
    <!-- Знаки «+» и «−» на кнопке diff вкладки: добавленное и удалённое. -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#7FB069" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#C2564A" />

    <FontFamily x:Key="UiFontFamily">IBM Plex Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Кнопка без рамки: подсветка только фоном, как в макете. -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка системной полосы заголовка: свернуть, развернуть, закрыть, настройки.
         Размер и скругление из макета (34×30, радиус 6). Кнопки обязаны быть
         hit-test-видимыми в обрамлении, иначе WindowChrome отдаст их клики
         перетаскиванию окна и ни одна из них не нажмётся. -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <!-- Кнопка с тонкой рамкой: «добавить проект» в шапке панели. -->
    <Style x:Key="OutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <!-- Толщина и скругления глифа. Цвет задаётся на самом Path: привязка к предку
         резолвится в визуальном дереве и в шаблоне кнопки может не найти Button,
         а невидимая иконка — это ошибка, которую не видно до запуска. -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Знак приложения: скруглённый квадрат акцентного цвета с приглашением `>_`.
         Нарисован в сетке 32×32 тремя фигурами — площадка, шеврон, подчёркивание.
         EvenOdd превращает вторую и третью фигуры в вырезы: сквозь них видно фон
         полосы заголовка (ChromeBackgroundBrush), отдельной заливки глифу не нужно.

         Геометрии две, и сводить их обратно в одну нельзя.

         Крупная идёт на кадры .ico от 24 px: шеврон нарисован честными диагоналями,
         на этих размерах просвет между его гранями виден и знак читается как `>`.

         Мелкая идёт на кадр 16 px и на полосу заголовка (Path 16×16). На сжатии 32→16
         тот же просвет схлопывался сглаживанием диагоналей, и знак читался сплошной
         стрелкой, а не `>`. Поэтому здесь диагонали выложены ступеньками по 2 единицы
         сетки: на 16 px это ровно один пиксель, грани шеврона попадают в целые пиксели,
         а просвет держится в целых два и размываться ему нечем. Подчёркивание по той же
         причине без скруглений — прямоугольник 8×4 единиц, то есть 4×2 пикселя.

         Площадка у обеих одинаковая: правка скругления вносится сразу в обе строки.

         Обе геометрии — единственный источник для src/ClaudeAgentsShell.App/Assets/app.ico:
         кадры .ico отрисованы из них, поэтому иконка в панели задач и знак в полосе
         заголовка не могут разойтись. Менять знак — только здесь и с перегенерацией .ico. -->
    <PathGeometry x:Key="AppMarkLargeGeometry"
                  FillRule="EvenOdd"
                  Figures="M7,0 L25,0 A7,7 0 0 1 32,7 L32,25 A7,7 0 0 1 25,32 L7,32 A7,7 0 0 1 0,25 L0,7 A7,7 0 0 1 7,0 Z M6,8 L14,16 L6,24 L6,19 L9,16 L6,13 Z M20,20 L24,20 A2,2 0 0 1 24,24 L20,24 A2,2 0 0 1 20,20 Z" />

    <PathGeometry x:Key="AppMarkSmallGeometry"
                  FillRule="EvenOdd"
                  Figures="M7,0 L25,0 A7,7 0 0 1 32,7 L32,25 A7,7 0 0 1 25,32 L7,32 A7,7 0 0 1 0,25 L0,7 A7,7 0 0 1 7,0 Z M6,8 L10,8 L10,10 L12,10 L12,12 L14,12 L14,14 L16,14 L16,18 L14,18 L14,20 L12,20 L12,22 L10,22 L10,24 L6,24 L6,22 L8,22 L8,20 L10,20 L10,18 L12,18 L12,14 L10,14 L10,12 L8,12 L8,10 L6,10 Z M18,20 L26,20 L26,24 L18,24 Z" />

    <!-- Знак в полосе заголовка: 16×16, поэтому геометрия мелкая. Намеренно не наследует
         IconPathStyle: тот настраивает обводку, а знак — заливка без штриха. -->
    <Style x:Key="AppMarkStyle" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        <Setter Property="Data" Value="{StaticResource AppMarkSmallGeometry}" />
    </Style>

    <!-- Тонкая тёмная полоса прокрутки вместо системной: без стрелок, только бегунок.
         Стиль именованный, а не неявный: Theme.xaml подключают все окна, и неявный стиль
         перекрасил бы прокрутку везде разом. Окно включает его у себя неявным стилем
         с BasedOn на этот ключ. Бегунок светлеет под курсором и при перетаскивании. -->
    <Style x:Key="ThinScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{StaticResource OutlineBrush}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource DisabledTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource FaintTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Щелчок по дорожке листает страницу, как у системной полосы; сама дорожка не видна. -->
    <Style x:Key="ThinScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- Вертикальная дорожка растёт сверху вниз только с обращённым направлением:
                         иначе бегунок ходил бы навстречу содержимому. -->
                    <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ThinScrollBarPageButtonStyle}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" MinHeight="24" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ThinScrollBarPageButtonStyle}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThinScrollBarPageButtonStyle}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" MinWidth="24" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ThinScrollBarPageButtonStyle}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}" />
    </Style>

</ResourceDictionary>
